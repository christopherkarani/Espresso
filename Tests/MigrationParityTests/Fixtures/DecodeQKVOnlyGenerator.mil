program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1, 768, 1, 32]> x) {
        fp16 norm_scale = const()[name=string("norm_scale"), val=fp16(0.25)];
        tensor<fp16, [1, 768, 1, 32]> norm_xs = mul(x=x, y=norm_scale)[name=string("norm_xs")];
        tensor<fp16, [1, 768, 1, 32]> norm_sq = mul(x=norm_xs, y=norm_xs)[name=string("norm_sq")];
        tensor<int32, [1]> norm_ss_axes = const()[name=string("norm_ss_axes"), val=tensor<int32, [1]>([1])];
        bool norm_ss_keep_dims = const()[name=string("norm_ss_keep_dims"), val=bool(true)];
        tensor<fp16, [1, 1, 1, 32]> norm_ss = reduce_sum(x=norm_sq, axes=norm_ss_axes, keep_dims=norm_ss_keep_dims)[name=string("norm_ss")];
        fp16 norm_invd = const()[name=string("norm_invd"), val=fp16(0.001302)];
        tensor<fp16, [1, 1, 1, 32]> norm_ms = mul(x=norm_ss, y=norm_invd)[name=string("norm_ms")];
        fp16 norm_eps = const()[name=string("norm_eps"), val=fp16(0.000001)];
        tensor<fp16, [1, 1, 1, 32]> norm_ss3 = add(x=norm_ms, y=norm_eps)[name=string("norm_ss3")];
        fp16 norm_nhalf = const()[name=string("norm_nhalf"), val=fp16(-0.5)];
        tensor<fp16, [1, 1, 1, 32]> norm_rrms = pow(x=norm_ss3, y=norm_nhalf)[name=string("norm_rrms")];
        tensor<fp16, [1, 768, 1, 32]> norm_xr = mul(x=norm_xs, y=norm_rrms)[name=string("norm_xr")];
        tensor<fp16, [1, 768, 1, 1]> norm_weight = const()[name=string("norm_weight"), val=tensor<fp16, [1, 768, 1, 1]>(BLOBFILE(path=string("@model_path/weights/rms1.bin"), offset=uint64(64)))];
        tensor<fp16, [1, 768, 1, 32]> norm_out = mul(x=norm_xr, y=norm_weight)[name=string("norm_out")];
        tensor<fp16, [768, 768, 1, 1]> q_weight = const()[name=string("q_weight"), val=tensor<fp16, [768, 768, 1, 1]>(BLOBFILE(path=string("@model_path/weights/wq.bin"), offset=uint64(64)))];
        string q_conv_pt = const()[name=string("q_conv_pt"), val=string("valid")];
        tensor<int32, [2]> q_conv_st = const()[name=string("q_conv_st"), val=tensor<int32, [2]>([1, 1])];
        tensor<int32, [4]> q_conv_pd = const()[name=string("q_conv_pd"), val=tensor<int32, [4]>([0, 0, 0, 0])];
        tensor<int32, [2]> q_conv_dl = const()[name=string("q_conv_dl"), val=tensor<int32, [2]>([1, 1])];
        int32 q_conv_gr = const()[name=string("q_conv_gr"), val=int32(1)];
        tensor<fp16, [1, 768, 1, 32]> q_conv = conv(dilations=q_conv_dl, groups=q_conv_gr, pad=q_conv_pd, pad_type=q_conv_pt, strides=q_conv_st, weight=q_weight, x=norm_out)[name=string("q_conv")];
        tensor<fp16, [768, 768, 1, 1]> k_weight = const()[name=string("k_weight"), val=tensor<fp16, [768, 768, 1, 1]>(BLOBFILE(path=string("@model_path/weights/wk.bin"), offset=uint64(64)))];
        string k_conv_pt = const()[name=string("k_conv_pt"), val=string("valid")];
        tensor<int32, [2]> k_conv_st = const()[name=string("k_conv_st"), val=tensor<int32, [2]>([1, 1])];
        tensor<int32, [4]> k_conv_pd = const()[name=string("k_conv_pd"), val=tensor<int32, [4]>([0, 0, 0, 0])];
        tensor<int32, [2]> k_conv_dl = const()[name=string("k_conv_dl"), val=tensor<int32, [2]>([1, 1])];
        int32 k_conv_gr = const()[name=string("k_conv_gr"), val=int32(1)];
        tensor<fp16, [1, 768, 1, 32]> k_conv = conv(dilations=k_conv_dl, groups=k_conv_gr, pad=k_conv_pd, pad_type=k_conv_pt, strides=k_conv_st, weight=k_weight, x=norm_out)[name=string("k_conv")];
        tensor<fp16, [768, 768, 1, 1]> v_weight = const()[name=string("v_weight"), val=tensor<fp16, [768, 768, 1, 1]>(BLOBFILE(path=string("@model_path/weights/wv.bin"), offset=uint64(64)))];
        string v_conv_pt = const()[name=string("v_conv_pt"), val=string("valid")];
        tensor<int32, [2]> v_conv_st = const()[name=string("v_conv_st"), val=tensor<int32, [2]>([1, 1])];
        tensor<int32, [4]> v_conv_pd = const()[name=string("v_conv_pd"), val=tensor<int32, [4]>([0, 0, 0, 0])];
        tensor<int32, [2]> v_conv_dl = const()[name=string("v_conv_dl"), val=tensor<int32, [2]>([1, 1])];
        int32 v_conv_gr = const()[name=string("v_conv_gr"), val=int32(1)];
        tensor<fp16, [1, 768, 1, 32]> v_conv = conv(dilations=v_conv_dl, groups=v_conv_gr, pad=v_conv_pd, pad_type=v_conv_pt, strides=v_conv_st, weight=v_weight, x=norm_out)[name=string("v_conv")];
        tensor<fp16, [1, 768, 1, 32]> qOut = identity(x=q_conv)[name=string("qOut")];
        tensor<fp16, [1, 768, 1, 32]> kNew = identity(x=k_conv)[name=string("kNew")];
        tensor<fp16, [1, 768, 1, 32]> vNew = identity(x=v_conv)[name=string("vNew")];
    } -> (qOut, kNew, vNew);
}
