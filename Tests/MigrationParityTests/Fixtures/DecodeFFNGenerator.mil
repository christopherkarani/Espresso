program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1, 768, 1, 32]> x) {
        fp16 norm_scale = const()[name=string("norm_scale"), val=fp16(0.25)];
        tensor<fp16, [1, 768, 1, 32]> norm_xs = mul(x=x, y=norm_scale)[name=string("norm_xs")];
        tensor<fp16, [1, 768, 1, 32]> norm_sq = mul(x=norm_xs, y=norm_xs)[name=string("norm_sq")];
        tensor<int32, [1]> norm_ss_axes = const()[name=string("norm_ss_axes"), val=tensor<int32, [1]>([1])];
        bool norm_ss_keep_dims = const()[name=string("norm_ss_keep_dims"), val=bool(true)];
        tensor<fp16, [1, 1, 1, 32]> norm_ss = reduce_sum(x=norm_sq, axes=norm_ss_axes, keep_dims=norm_ss_keep_dims)[name=string("norm_ss")];
        fp16 norm_invd = const()[name=string("norm_invd"), val=fp16(0.001302)];
        tensor<fp16, [1, 1, 1, 32]> norm_ms = mul(x=norm_ss, y=norm_invd)[name=string("norm_ms")];
        fp16 norm_eps = const()[name=string("norm_eps"), val=fp16(0.000001)];
        tensor<fp16, [1, 1, 1, 32]> norm_ss3 = add(x=norm_ms, y=norm_eps)[name=string("norm_ss3")];
        fp16 norm_nhalf = const()[name=string("norm_nhalf"), val=fp16(-0.5)];
        tensor<fp16, [1, 1, 1, 32]> norm_rrms = pow(x=norm_ss3, y=norm_nhalf)[name=string("norm_rrms")];
        tensor<fp16, [1, 768, 1, 32]> norm_xr = mul(x=norm_xs, y=norm_rrms)[name=string("norm_xr")];
        tensor<fp16, [1, 768, 1, 1]> norm_weight = const()[name=string("norm_weight"), val=tensor<fp16, [1, 768, 1, 1]>(BLOBFILE(path=string("@model_path/weights/rms2.bin"), offset=uint64(64)))];
        tensor<fp16, [1, 768, 1, 32]> norm_out = mul(x=norm_xr, y=norm_weight)[name=string("norm_out")];
        tensor<fp16, [2048, 768, 1, 1]> ffn_gate_weight = const()[name=string("ffn_gate_weight"), val=tensor<fp16, [2048, 768, 1, 1]>(BLOBFILE(path=string("@model_path/weights/w1.bin"), offset=uint64(64)))];
        string ffn_gate_conv_pt = const()[name=string("ffn_gate_conv_pt"), val=string("valid")];
        tensor<int32, [2]> ffn_gate_conv_st = const()[name=string("ffn_gate_conv_st"), val=tensor<int32, [2]>([1, 1])];
        tensor<int32, [4]> ffn_gate_conv_pd = const()[name=string("ffn_gate_conv_pd"), val=tensor<int32, [4]>([0, 0, 0, 0])];
        tensor<int32, [2]> ffn_gate_conv_dl = const()[name=string("ffn_gate_conv_dl"), val=tensor<int32, [2]>([1, 1])];
        int32 ffn_gate_conv_gr = const()[name=string("ffn_gate_conv_gr"), val=int32(1)];
        tensor<fp16, [1, 2048, 1, 32]> ffn_gate_conv = conv(dilations=ffn_gate_conv_dl, groups=ffn_gate_conv_gr, pad=ffn_gate_conv_pd, pad_type=ffn_gate_conv_pt, strides=ffn_gate_conv_st, weight=ffn_gate_weight, x=norm_out)[name=string("ffn_gate_conv")];
        tensor<fp16, [2048, 768, 1, 1]> ffn_up_weight = const()[name=string("ffn_up_weight"), val=tensor<fp16, [2048, 768, 1, 1]>(BLOBFILE(path=string("@model_path/weights/w3.bin"), offset=uint64(64)))];
        string ffn_up_conv_pt = const()[name=string("ffn_up_conv_pt"), val=string("valid")];
        tensor<int32, [2]> ffn_up_conv_st = const()[name=string("ffn_up_conv_st"), val=tensor<int32, [2]>([1, 1])];
        tensor<int32, [4]> ffn_up_conv_pd = const()[name=string("ffn_up_conv_pd"), val=tensor<int32, [4]>([0, 0, 0, 0])];
        tensor<int32, [2]> ffn_up_conv_dl = const()[name=string("ffn_up_conv_dl"), val=tensor<int32, [2]>([1, 1])];
        int32 ffn_up_conv_gr = const()[name=string("ffn_up_conv_gr"), val=int32(1)];
        tensor<fp16, [1, 2048, 1, 32]> ffn_up_conv = conv(dilations=ffn_up_conv_dl, groups=ffn_up_conv_gr, pad=ffn_up_conv_pd, pad_type=ffn_up_conv_pt, strides=ffn_up_conv_st, weight=ffn_up_weight, x=norm_out)[name=string("ffn_up_conv")];
        tensor<fp16, [1, 2048, 1, 32]> ffn_gate_act_sigmoid = sigmoid(x=ffn_gate_conv)[name=string("ffn_gate_act_sigmoid")];
        tensor<fp16, [1, 2048, 1, 32]> ffn_gate_act_out = mul(x=ffn_gate_conv, y=ffn_gate_act_sigmoid)[name=string("ffn_gate_act_out")];
        tensor<fp16, [1, 2048, 1, 32]> ffn_gated = mul(x=ffn_gate_act_out, y=ffn_up_conv)[name=string("ffn_gated")];
        tensor<fp16, [768, 2048, 1, 1]> ffn_down_weight = const()[name=string("ffn_down_weight"), val=tensor<fp16, [768, 2048, 1, 1]>(BLOBFILE(path=string("@model_path/weights/w2.bin"), offset=uint64(64)))];
        string ffn_down_conv_pt = const()[name=string("ffn_down_conv_pt"), val=string("valid")];
        tensor<int32, [2]> ffn_down_conv_st = const()[name=string("ffn_down_conv_st"), val=tensor<int32, [2]>([1, 1])];
        tensor<int32, [4]> ffn_down_conv_pd = const()[name=string("ffn_down_conv_pd"), val=tensor<int32, [4]>([0, 0, 0, 0])];
        tensor<int32, [2]> ffn_down_conv_dl = const()[name=string("ffn_down_conv_dl"), val=tensor<int32, [2]>([1, 1])];
        int32 ffn_down_conv_gr = const()[name=string("ffn_down_conv_gr"), val=int32(1)];
        tensor<fp16, [1, 768, 1, 32]> ffn_down_conv = conv(dilations=ffn_down_conv_dl, groups=ffn_down_conv_gr, pad=ffn_down_conv_pd, pad_type=ffn_down_conv_pt, strides=ffn_down_conv_st, weight=ffn_down_weight, x=ffn_gated)[name=string("ffn_down_conv")];
        tensor<fp16, [1, 768, 1, 32]> out = add(x=x, y=ffn_down_conv)[name=string("out")];
    } -> (out);
}
